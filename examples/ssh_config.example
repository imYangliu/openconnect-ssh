# Copy only the desired Host block into your own SSH config.
Host campus-fixed
  HostName server.internal.example
  User your_ssh_user
  ProxyCommand /absolute/path/to/och proxy-command --config /absolute/path/to/config.yaml --via campus %h %p

Host campus-auto
  HostName 10.20.0.10
  User your_ssh_user
  ProxyCommand /absolute/path/to/och proxy-command --config /absolute/path/to/config.yaml --policy campus-auto %h %p
